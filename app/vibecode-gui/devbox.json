{
  "$schema":  "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",
  "packages": ["bun@1.4.2"],
  "shell": {
    "scripts": {
      "install":      "hutch run install",
      "start":        "hutch run start",
      "dev":          "hutch run dev",
      "dev:hmr":      "hutch run dev:hmr",
      "hmr":          "hutch run hmr",
      "build":        "hutch run build",
      "build:canary": "hutch run build:canary"
    }
  }
}
